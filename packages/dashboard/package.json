{
  "name": "@warden/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "sim": "pnpm --filter @warden/warden sim && tsx src/server.ts --state ../../.warden/sim",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@warden/shared": "workspace:*", "@warden/warden": "workspace:*" }
}
