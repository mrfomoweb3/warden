{
  "name": "warden-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "test:move": "cd packages/vault && sui move test",
    "warden": "pnpm --filter @warden/warden start",
    "paid-apis": "pnpm --filter @warden/paid-apis start",
    "agents": "pnpm --filter @warden/agents start",
    "dashboard": "pnpm --filter @warden/dashboard start",
    "dashboard:sim": "pnpm --filter @warden/dashboard sim",
    "sim": "pnpm --filter @warden/warden sim"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
