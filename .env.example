# ── Tatum ───────────────────────────────────────────────────────────────
TATUM_API_KEY=
# Tatum Sui gRPC (Sui deprecated JSON-RPC in 2026). Mainnet: https://sui-mainnet-grpc.gateway.tatum.io
TATUM_SUI_RPC_URL=https://sui-testnet-grpc.gateway.tatum.io
TATUM_ACCOUNT_ID=                 # submission form only
TATUM_MAX_RPS=3                   # per-process call rate cap (Tatum rate-limits bursts with HTTP 429)

# ── Walrus Memory ───────────────────────────────────────────────────────
MEMWAL_AGENT_ID=                  # delegate public key (memory.walrus.xyz/dashboard → Delegate keys); submission form
MEMWAL_DELEGATE_KEY=              # delegate private key (hex or suiprivkey1...)
MEMWAL_ACCOUNT_ID=                # Walrus Memory account object ID on Sui
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=warden
# Set to "mock" to run fully offline (MemWalMock, nothing written on chain)
MEMWAL_MODE=live

# ── Sui ─────────────────────────────────────────────────────────────────
SUI_NETWORK=testnet               # switch to mainnet in week 3
WARDEN_PRIVATE_KEY=               # suiprivkey1... — holds WardenCap only
WARDEN_CAP_ID=
OWNER_ADDRESS=
VAULT_PACKAGE_ID=
VAULT_OBJECT_ID=
VAULT_COIN_TYPE=0x2::sui::SUI
# Display price of 1 whole vault coin in USD (rules are written in $)
VAULT_COIN_USD=1
VAULT_COIN_DECIMALS=9

# ── Demo agents (one SpenderCap each) ──────────────────────────────────
RESEARCHER_PRIVATE_KEY=
RESEARCHER_CAP_ID=
PRICEBOT_PRIVATE_KEY=
PRICEBOT_CAP_ID=
ROGUE_PRIVATE_KEY=
ROGUE_CAP_ID=

# ── x402 (self-hosted, settled on Sui) ─────────────────────────────────
PAID_API_URL=http://localhost:4021
PAID_API_PAYTO=                   # address that receives x402 payments
# Optional: one pay-to address per vendor so they look like different counterparties
# PAID_API_VENDORS=search:0x…,search-b:0x…,search-c:0x…,price:0x…,risk:0x…
X402_PAYER_KEY=                   # Warden's own small wallet for paid risk checks

# ── LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=                     # optional: parses plain-English rules (console.groq.com); without it a pattern parser is used
GROQ_MODEL=openai/gpt-oss-120b

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ── Loop tuning ─────────────────────────────────────────────────────────
POLL_FAST_MS=15000
POLL_IDLE_MS=120000
# WARDEN_STATE_DIR=../../.warden  # local cache of Walrus memories (default shown)
# DASHBOARD_PORT=4300
